# Copy to .devcontainer/.env (git-ignored) and name what this host has. Every entry is optional: one left unset or
# empty gives an empty named volume, shared with dsbench's own containers. The first three and the last mean the same
# as in dsbench's .env. Rebuild the container after a change.

# The datasets, mounted read only at /bench/data (SecretBench: Files/ and secretbench.csv)
DSBENCH_DATA_DIR=
# The bench home, mounted at /bench/home: dsbench's store, runs and reports. It holds real secret values, so keep it
# outside every repository
DSBENCH_HOME_DIR=
# A dsbench checkout, mounted at /workspaces/dsbench and installed as `dsbench` when the container is created
DSBENCH_REPO_DIR=
# Docker network for the build and the container: empty for Docker's default, `host` on an IPv6-only network
DSBENCH_NETWORK=
