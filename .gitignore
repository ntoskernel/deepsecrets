# Dotted files and directories at the root are local: tool caches (.pytest_cache, .mypy_cache, .coverage), editors and
# agents (.idea, .claude), environments (.env, .venv). The tracked ones are listed back in; dotted files deeper down
# are not ignored, so a fixture such as tests/fixtures/.env can be committed
/.*
!/.gitignore
!/.github/
!/.devcontainer/
!/.vscode/
# the devcontainer's local settings (.env.example is the tracked template; certs/ ignores itself)
/.devcontainer/.env

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
parts/
sdist/
var/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
nosetests.xml
coverage.xml
*,cover

# virtualenv
venv/

# auto generated docs
doc.html

# misc
/workdir
*.zip
playground/
*.db
pytest*

/benchmarker/
/tests/fixtures/problem_files/
/*.json
# the multi-root workspace .devcontainer/workspace.sh writes
/*.code-workspace

# Agent docs: a private repository that maintainers with access clone here (see AGENTS.md)
/docs/private/
# The root AGENTS.md and CLAUDE.md are its public proxies; the scoped CLAUDE.md files are generated by
# docs/private/install.sh and must stay out of git, and out of the wheel
AGENTS.md
CLAUDE.md
!/AGENTS.md
!/CLAUDE.md
research/
